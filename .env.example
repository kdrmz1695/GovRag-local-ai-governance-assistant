# GovRAG local configuration
# Copy this file to .env and replace placeholder values.
# Never commit the populated .env file.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=govrag
DB_USER=postgres
DB_PASSWORD=change_me

# Foundry Local
# start_govrag.ps1 discovers the active port and rewrites FOUNDRY_BASE_URL.
FOUNDRY_BASE_URL=http://127.0.0.1:PORT/v1

# Embeddings
EMBEDDING_MODEL_ALIAS=qwen3-embedding-0.6b
EMBEDDING_MODEL_ID=<foundry-embedding-model-id>
EMBEDDING_MODEL_VERSION=<embedding-model-version>
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8

# Retrieval / reranking
# The reranker is loaded with local_files_only=True.
RERANKER_MODEL_ID=<local-or-cached-cross-encoder-model-id>
RERANKER_DEVICE=cuda
RETRIEVAL_CANDIDATE_K=20
RERANK_TOP_K=4

# Local chat generation
CHAT_MODEL_ID=<foundry-chat-model-id>
CHAT_TEMPERATURE=0.0
CHAT_MAX_TOKENS=800
